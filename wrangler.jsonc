{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "observatorio-sst",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "observatorio-sst",
      "database_id": "83f4705e-44b4-4feb-8c9f-b9692548ef7d",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "sst.andesnova.solutions", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 11 * * *"] },
  "observability": { "enabled": true }
}

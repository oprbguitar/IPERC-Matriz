{
  "name": "iperc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:links": "node scripts/check-links.mjs",
    "preview": "vite preview",
    "build:worker": "tsc -p tsconfig.worker.json",
    "scrape:norms": "node scripts/scrape-norms.mjs",
    "import:iso": "node scripts/import-iso.mjs",
    "create:user": "node scripts/create-user.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply observatorio-sst --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wrangler": "^4.157.0"
  }
}
